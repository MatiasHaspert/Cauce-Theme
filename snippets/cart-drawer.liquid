{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  CAUCE (D-081): el contenido del drawer es el carrito CAUCE (snippets/cauce-carrito.liquid).
  De Horizon se conserva el contenedor: <theme-drawer>, el <dialog>, <cart-drawer-component>
  y <cart-items-component>, que son los que abren, cierran y actualizan el carrito.
  Los bloques del carrito son los de sections/cart-drawer-section.liquid, que ahora se
  renderiza como seccion estatica desde layout/theme.liquid para que el comercio pueda
  prender, apagar y reordenar las piezas desde el editor (D-046).

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
  @param {object} [section] - La seccion cart-drawer-section, con sus bloques y settings.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
  assign cauce_bloques = section.blocks
  assign cauce_titulo = section.settings.heading_text | default: 'Tu carrito'
  assign cauce_esquema = section.settings.color_scheme | default: 'background-1'
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    {%- comment -%}
      Lo que <cart-items-component> pone en el lugar del carrito cuando se quita
      la ultima linea, antes de que llegue la respuesta del servidor.
    {%- endcomment -%}
    <div class="cauce-carrito__vacio-wrap cart-drawer--empty" data-cart-drawer-empty>
      <div class="cauce-carrito__cabecera">
        <h2 class="cauce-carrito__titulo" id="cart-drawer-heading">
          {{- cauce_titulo | replace: '[count]', 0 -}}
        </h2>
        <button
          type="button"
          class="cauce-carrito__cerrar"
          on:click="#cart-drawer/close"
          aria-label="{{ 'actions.close' | t }}"
        >
          {%- render 'cauce-iconos', icono: 'cruz' -%}
        </button>
      </div>
      {%- liquid
        if settings.cauce_carrito_vacio_url != blank
          assign cauce_vacio_url = settings.cauce_carrito_vacio_url
        else
          assign cauce_vacio_url = routes.all_products_collection_url
        endif
      -%}
      {% render 'cauce-carrito-vacio', url: cauce_vacio_url %}
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer cauce-carrito-dialog"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner cauce-carrito cauce-carrito--drawer cauce-seccion color-{{ cauce_esquema }}"
          data-hydration-key="cart-drawer-inner"
        >
          {% capture cart_items_children %}
            {% render 'cauce-carrito',
              bloques: cauce_bloques,
              contexto: 'drawer',
              titulo: cauce_titulo
            %}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    display: contents;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }
{% endstylesheet %}
