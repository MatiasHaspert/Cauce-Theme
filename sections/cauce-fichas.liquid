{% comment %}
  CAUCE — carrusel de fichas.

  Una ficha por ingrediente: el nombre arriba, la foto grande en el medio y abajo
  una linea con lo que hace, que se despliega con mas texto. En telefono es un
  carrusel de scroll-snap, como los demas del tema (no depende de JS); en
  escritorio, una grilla.

  Por que no cauce-ingredientes: aquella es una grilla de tarjetas chicas para
  ocho activos, con la foto como circulo o como fondo. Aca son pocos ingredientes
  y la foto es la pieza: una placa de vidrio por ingrediente, vista desde arriba.
  Ver docs/DECISIONS.md D-074.

  Tres cosas que la seccion resuelve por construccion:

  - Sin foto, la ficha dibuja snippets/cauce-foto-pendiente.liquid con el pedido
    de produccion, en la misma proporcion que tendra la foto.
  - El texto largo va en un <details>: se abre sin JS y un lector de pantalla lo
    anuncia como desplegable. Sin texto largo, la linea queda sola, sin control.
  - La lista es un <ul> real con tabindex en el carrusel, para poder recorrerla
    con el teclado.

  ADVERTENCIA DE CLAIMS (SENASA, productos veterinarios). Cada ficha le atribuye
  una funcion a un ingrediente: una linea sobria con lo que hace en la boca. Sin
  "antiinflamatorio", sin "disuelve el sarro", sin "clinicamente probado". El
  texto vive entero en templates/*.json. No escribas copy adentro de este archivo.
{% endcomment %}

{%- liquid
  assign cauce_n = 0
  for block in section.blocks
    if block.settings.nombre != blank
      assign cauce_n = cauce_n | plus: 1
    endif
  endfor

  assign cauce_hay = false
  if cauce_n > 0 or section.settings.titulo != blank
    assign cauce_hay = true
  endif

  assign cauce_cols = cauce_n | at_most: 4 | at_least: 1
  assign cauce_ancho_ficha = section.settings.ancho_maximo | divided_by: cauce_cols
  assign cauce_sizes = '(min-width: 990px) ' | append: cauce_ancho_ficha | append: 'px, (min-width: 750px) 45vw, 80vw'
  assign cauce_estilo_foto = 'aspect-ratio: ' | append: section.settings.relacion
-%}

{%- if cauce_hay -%}
  <div class="cauce-fichas-seccion color-{{ section.settings.color_scheme }} cauce-seccion">
    <div
      class="page-width cauce-fichas-seccion__inner"
      style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --cauce-fichas-ancho: {{ section.settings.ancho_maximo }}px; --cauce-fichas-cols: {{ cauce_cols }};"
    >
      {%- if section.settings.volanta != blank or section.settings.titulo != blank or section.settings.bajada != blank -%}
        <div class="cauce-fichas-seccion__encabezado">
          {%- if section.settings.volanta != blank -%}
            <p class="cauce-eyebrow">{{ section.settings.volanta }}</p>
          {%- endif -%}
          {%- if section.settings.titulo != blank -%}
            <h2 class="cauce-fichas-seccion__titulo {{ section.settings.heading_size }}">{{ section.settings.titulo }}</h2>
          {%- endif -%}
          {%- if section.settings.bajada != blank -%}
            <div class="cauce-fichas-seccion__bajada rte">{{ section.settings.bajada }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if cauce_n > 0 -%}
        <ul
          class="cauce-fichas-carrusel"
          role="list"
          tabindex="0"
          aria-label="{{ section.settings.etiqueta_a11y | default: section.settings.titulo | strip_html | escape }}"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              if block.settings.nombre == blank
                continue
              endif
              assign cauce_alt = block.settings.alt | default: block.settings.imagen.alt
            -%}
            <li class="cauce-fichas-carrusel__ficha" {{ block.shopify_attributes }}>
              <h3 class="cauce-fichas-carrusel__nombre">{{ block.settings.nombre }}</h3>

              {%- if block.settings.imagen != blank -%}
                {{
                  block.settings.imagen
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640, 800, 1200',
                    sizes: cauce_sizes,
                    class: 'cauce-fichas-carrusel__imagen',
                    style: cauce_estilo_foto,
                    alt: cauce_alt
                }}
              {%- else -%}
                {%- render 'cauce-foto-pendiente',
                  etiqueta: block.settings.foto_pendiente,
                  relacion: section.settings.relacion,
                  clase: 'cauce-fichas-carrusel__imagen'
                -%}
              {%- endif -%}

              {%- if block.settings.detalle != blank -%}
                <details class="cauce-fichas-carrusel__mas">
                  <summary class="cauce-fichas-carrusel__funcion">
                    <span>{{ block.settings.funcion }}</span>
                    {%- render 'cauce-iconos', icono: 'mas', clase: 'cauce-fichas-carrusel__abrir' -%}
                    {%- render 'cauce-iconos', icono: 'menos', clase: 'cauce-fichas-carrusel__cerrar' -%}
                  </summary>
                  <div class="cauce-fichas-carrusel__detalle rte">{{ block.settings.detalle }}</div>
                </details>
              {%- elsif block.settings.funcion != blank -%}
                <p class="cauce-fichas-carrusel__funcion">{{ block.settings.funcion }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.pie != blank -%}
        <div class="cauce-fichas-seccion__pie rte">{{ section.settings.pie }}</div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "CAUCE · Fichas",
  "tag": "section",
  "class": "cauce-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Una ficha por ingrediente: nombre, foto y una linea sobria con lo que hace. Sin \"antiinflamatorio\", sin \"disuelve el sarro\" y sin \"clinicamente probado\"."
    },

    { "type": "header", "content": "Texto" },
    { "type": "text", "id": "volanta", "label": "Volanta" },
    { "type": "inline_richtext", "id": "titulo", "label": "Titulo" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamano del titulo",
      "options": [
        { "value": "h2", "label": "Chico" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    { "type": "richtext", "id": "bajada", "label": "Bajada" },
    { "type": "richtext", "id": "pie", "label": "Texto al pie" },
    {
      "type": "text",
      "id": "etiqueta_a11y",
      "label": "Nombre accesible del carrusel",
      "info": "Si esta vacio se usa el titulo."
    },

    { "type": "header", "content": "Fotos" },
    {
      "type": "select",
      "id": "relacion",
      "label": "Relacion de aspecto",
      "options": [
        { "value": "1 / 1", "label": "1:1 cuadrada" },
        { "value": "4 / 5", "label": "4:5 vertical" },
        { "value": "4 / 3", "label": "4:3" }
      ],
      "default": "1 / 1"
    },

    { "type": "header", "content": "Presentacion" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de color",
      "options": [
        { "value": "background-1", "label": "Fondo" },
        { "value": "background-2", "label": "Superficie" },
        { "value": "inverse", "label": "Oscuro" }
      ],
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "ancho_maximo",
      "min": 720,
      "max": 1400,
      "step": 40,
      "unit": "px",
      "label": "Ancho del bloque",
      "default": 1200
    },

    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Arriba", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Abajo", "default": 72 }
  ],
  "blocks": [
    {
      "type": "ficha",
      "name": "Ficha",
      "settings": [
        { "type": "text", "id": "nombre", "label": "Nombre" },
        { "type": "image_picker", "id": "imagen", "label": "Foto" },
        { "type": "text", "id": "alt", "label": "Texto alternativo" },
        {
          "type": "text",
          "id": "foto_pendiente",
          "label": "Pedido de foto",
          "info": "Mientras no haya foto, se dibuja un recuadro con este texto."
        },
        { "type": "text", "id": "funcion", "label": "Que hace, en una linea" },
        { "type": "richtext", "id": "detalle", "label": "Texto que se despliega", "info": "Vacio = la linea queda sola." }
      ]
    }
  ],
  "presets": [
    {
      "name": "CAUCE · Fichas",
      "blocks": [
        { "type": "ficha" },
        { "type": "ficha" },
        { "type": "ficha" }
      ]
    }
  ]
}
{% endschema %}
